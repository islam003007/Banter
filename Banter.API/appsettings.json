{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.Seq"
    ],

    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },

    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "Seq",
        "Args": {
          "serverUrl": "http://seq:5341"
        }
      }
    ]
  },

  "AllowedHosts": "*",

  "Demo": {
    "Enabled": false,
    "Reset": {
      "Enabled": false,
      "IntervalHours": 24
    }
  },

  "RateLimit": {
    "Enabled": true,
    "PermitLimit": 120,
    "WindowSeconds": 60
  }
}
