# Project Settings
COMPOSE_PROJECT_NAME=banter

# Image Versions
POSTGRES_VERSION=14.22-trixie
REDIS_VERSION=8.6.2-trixie
SEQ_VERSION=2026.1.16587-pre

# Infrastructure Ports (Host Side)
POSTGRES_PORT=5432
REDIS_PORT=6379
SEQ_PORT=5431

# Sensitive Data

# Public demo-only seed password. Required before seeding; the API fails to
# start if it is missing or does not satisfy the Identity password policy.
# Must have 8+ chars, upper, lower, digit, and a non-alphanumeric character.
# Never reuse outside the local demo database.
DATA_SEED_USERS_PASSWORD=REPLACE_WITH_VALID_DEMO_PASSWORD_123!

# Database Configuration (Development Defaults)
DB_USER=admin
DB_PASSWORD=REPLACE_WITH_SECURE_PASSWORD
DB_NAME=banter_db

# Redis Security
REDIS_PASSWORD=REPLACE_WITH_SECURE_PASSWORD

# Seq Security
SEQ_ADMIN_PASSWORD=REPLACE_WITH_SECURE_PASSWORD



