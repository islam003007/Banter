# Banter API — Northflank environment template
# Copy this file to northflank.env (gitignored), fill in the values, and
# paste the keys into the Banter API service environment in Northflank.
# Never commit real connection strings or passwords.

ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_HTTP_PORTS=8080

# Northflank terminates TLS and forwards HTTP to the container.
ASPNETCORE_FORWARDEDHEADERS_ENABLED=true

# Neon PostgreSQL
# Use the direct (non-pooler) host here: Banter applies EF migrations at startup.
ConnectionStrings__Postgres=Host=<neon-host>;Port=5432;Database=<database>;Username=<user>;Password=<password>;SSL Mode=Require;Trust Server Certificate=false

# Upstash Redis
ConnectionStrings__Redis=<upstash-host>:6379,password=<password>,ssl=True,abortConnect=false

Demo__Enabled=true
# Required for fresh seeding. Must satisfy the Identity password policy:
# 8+ chars, uppercase, lowercase, digit, and non-alphanumeric.
DataSeed__UsersPassword=REPLACE_WITH_VALID_DEMO_PASSWORD_123!

# Only enable this against a dedicated demo database. It wipes all rows and reseeds.
Demo__Reset__Enabled=true
Demo__Reset__IntervalHours=24

# Per-IP fixed-window limiter.
RateLimit__Enabled=true
RateLimit__PermitLimit=120
RateLimit__WindowSeconds=60

# Exact frontend origin allowed by CORS. Scheme + host + optional port, no path,
# no trailing slash. Add more origins with __1, __2, ... if needed.
Frontend__AllowedOrigins__0=https://<frontend-origin>
