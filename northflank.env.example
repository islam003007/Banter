# Banter API — Northflank environment template
# Copy this file to northflank.env (gitignored), fill in the values, and
# paste the keys into the Banter API service environment in Northflank.
# Never commit real connection strings or passwords.

ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_HTTP_PORTS=8080

# Neon PostgreSQL
# Use the direct (non-pooler) host here: Banter applies EF migrations at startup.
ConnectionStrings__Postgres=Host=<neon-host>;Port=5432;Database=<database>;Username=<user>;Password=<password>;SSL Mode=Require;Trust Server Certificate=false

# Upstash Redis
ConnectionStrings__Redis=<upstash-host>:6379,password=<password>,ssl=True,abortConnect=false
